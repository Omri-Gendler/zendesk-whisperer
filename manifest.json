{
  "manifest_version": 3,
  "name": "Arbitrip Zendesk Copilot",
  "version": "0.1.0",
  "description": "Side panel copilot for Zendesk. Reads the open ticket from the page. Summaries stay on this computer — never sent to public AI APIs.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://arbitrip-support.zendesk.com/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "cmps/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://arbitrip-support.zendesk.com/*"],
      "js": [
        "cmps/ticket-reader/constants.js",
        "cmps/ticket-reader/selectors-pane.js",
        "cmps/ticket-reader/selectors-thread.js",
        "cmps/ticket-reader/selectors-fields.js",
        "cmps/ticket-reader/labels.js",
        "cmps/ticket-reader/query.js",
        "cmps/ticket-reader/visible.js",
        "cmps/ticket-reader/composer.js",
        "cmps/ticket-reader/ticket-id.js",
        "cmps/ticket-reader/ticket-id-hints.js",
        "cmps/ticket-reader/ticket-id-links.js",
        "cmps/ticket-reader/subject.js",
        "cmps/ticket-reader/message-clean.js",
        "cmps/ticket-reader/message-strip.js",
        "cmps/ticket-reader/message-meta.js",
        "cmps/ticket-reader/parse-message.js",
        "cmps/ticket-reader/messages.js",
        "cmps/ticket-reader/field-label.js",
        "cmps/ticket-reader/field-value.js",
        "cmps/ticket-reader/field-dtdd.js",
        "cmps/ticket-reader/field-push.js",
        "cmps/ticket-reader/fields.js",
        "cmps/ticket-reader/build-ticket.js",
        "cmps/ticket-reader/send.js",
        "cmps/ticket-reader/publish.js",
        "cmps/ticket-reader/observer.js",
        "cmps/ticket-reader/history.js",
        "cmps/ticket-reader/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "cmps/sidepanel/sidepanel.html"
  },
  "options_page": "cmps/options/options.html",
  "action": {
    "default_title": "Arbitrip Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
